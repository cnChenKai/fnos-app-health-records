{
  "name": "fnos-app-health-records",
  "version": "0.1.7",
  "description": "Family health report archive and AI-assisted record management for fnOS",
  "type": "module",
  "author": {
    "name": "timor-m"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timor-m/fnos-app-health-records.git"
  },
  "templateRepository": {
    "type": "git",
    "url": "git+https://github.com/timor-m/fnos-app-template.git"
  },
  "bugs": {
    "url": "https://github.com/timor-m/fnos-app-health-records/issues"
  },
  "homepage": "https://github.com/timor-m/fnos-app-health-records#readme",
  "workspaces": [
    "packages/ui",
    "packages/server",
    "packages/assets"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --config packages/ui/vite.config.ts",
    "dev:server": "node scripts/dev.mjs",
    "test": "tsx --test packages/server/tests/*.test.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:web": "vite build --config packages/ui/vite.config.ts",
    "build": "npm run build:web && nitro build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "release:info": "node scripts/release-info.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:auto": "node scripts/bump-version.mjs auto",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "validate:release": "npm run validate:migrations && node scripts/validate-release.mjs",
    "release:ci": "npm run validate:release && npm test && npm run typecheck && npm run download:fnpack && npm run pack:fpk",
    "release:build": "npm run release:ci",
    "release": "node scripts/local-release.mjs",
    "start": "node scripts/start.mjs",
    "download:fnpack": "node scripts/download-fnpack.mjs",
    "prepare:package": "node scripts/prepare-package.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "pack:app": "npm run build && npm run prepare:package && bash scripts/pack-app.sh && npm run validate:package",
    "pack:fpk": "npm run pack:app && bash scripts/pack-fpk.sh"
  },
  "dependencies": {
    "@lucide/vue": "^1.25.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.2.4",
    "nitro": "3.0.260610-beta",
    "vite": "^8.0.16",
    "vue": "^3.5.38",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vue-tsc": "^3.0.5"
  }
}
